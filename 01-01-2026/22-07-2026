package DAY2;

import java.util.Scanner;

public class VoterApp { 
    public static void main(String[] args) {
    String name="", pan="", email="", aadhar="", mobile="";
    boolean isValid = true;
    Scanner sscet = new Scanner(System.in);
    System.out.println("enter the name");
    name = sscet.nextLine();
    System.out.println("enter the email");
    email=sscet.next();
    System.out.println("enter the mobile number");
    mobile=sscet.next();
    System.out.println("enter the aadhar");
    aadhar=sscet.next();
    System.out.println("enter the pan");
    pan=sscet.next();
    if(!name.matches("^[A-Za-z ]{5,}$"))
    {isValid=false;System.out.println("Invalid Name");}
    if(!email.matches("^[A-Za-z0-9_.-]{2,}@[A-Za-z]{3,}+\\.[a-z]{2,}$"))
    {isValid=false;System.out.println("Invalid email");}
    if(!mobile.matches("^[0-9]{10}$"))
    {isValid=false;System.out.println("Invalid mobile number");}
    if(!aadhar.matches("^[0-9]{12}$"))
    {isValid=false;System.out.println("Invalid aadhar");}
    if(!pan.matches("^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
    {isValid=false;System.out.println("Invalid pan");}
    if(isValid)
        System.out.println(name+" voter application submitted further updates send to "+mobile+" or "+email);
    else System.out.println("Application Rejected");
    }
}
