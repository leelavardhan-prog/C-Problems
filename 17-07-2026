int minCostClimbingStairs(int* cost, int costSize) {
    int prev2 = 0;
    int prev1 = 0;

    for (int i = 2; i <= costSize; i++) {
        int current;

        if (prev1 + cost[i - 1] < prev2 + cost[i - 2])
            current = prev1 + cost[i - 1];
        else
            current = prev2 + cost[i - 2];

        prev2 = prev1;
        prev1 = current;
    }

    return prev1;
}
